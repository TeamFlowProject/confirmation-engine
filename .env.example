# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8002

# --- Database (Postgres) ---
DATABASE_DSN=postgresql://user:password@localhost:5432/confirmation_db
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_COMMANDS=confirmation-commands
KAFKA_TOPIC_EVENTS=event-events
KAFKA_GROUP_ID=confirmation-engine

# --- Logging ---
LOG_LEVEL=INFO
