# Confirmation Engine — copy to .env_event_service and adjust if needed
# cp .env_event_service.example .env_event_service

EVENT_SERVICE_PORT=8002

DATABASE_DSN=postgresql://user:password@postgres:5432/event_db
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC_COMMANDS=event-commands
KAFKA_TOPIC_EVENTS=event-events
KAFKA_GROUP_ID=confirmation-engine

HTTP_HOST=0.0.0.0
HTTP_PORT=8001

LOG_LEVEL=INFO
